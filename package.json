{
  "name": "izinpro",
  "version": "1.0.0",
  "private": true,
  "description": "Lokal personel izin talep ve yönetim sistemi",
  "main": "backend/server.js",
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "prestart": "node scripts/check-node.js",
    "prestart:vs": "node scripts/check-node.js",
    "start": "node backend/server.js",
    "start:vs": "node scripts/start-visual-studio.js",
    "build:cloudflare": "node scripts/build-cloudflare.js",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config cloudflare/wrangler.jsonc",
    "dev": "node --watch backend/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-static": "^0.544.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "wrangler": "^4.129.1"
  }
}
